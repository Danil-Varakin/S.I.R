<!-- [MANIFEST] новая activity внутри <application> AndroidManifest -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.chromium.chrome">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name="org.chromium.chrome.browser.ChromeApplication">
        <activity android:name="org.chromium.chrome.browser.ChromeTabbedActivity"
            android:exported="true" />
        <service android:name="org.chromium.chrome.browser.DownloadService" />
    </application>
</manifest>
