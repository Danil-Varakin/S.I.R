// [KEYS] upstream переставил ключи background — замена держится за свою строку
{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "type": "classic",
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
