# deep design notes (RU): a working folder, kept out of git (see structure.md)
docs/

# dependencies
node_modules/

# TypeScript build output
dist/
*.tsbuildinfo

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# leftovers of the atomic write in infra/fs.ts, should a run be interrupted
*.tmp

# environment
.env
.env.*

# macOS
.DS_Store

# editors
.idea/
.vscode/

# scratch output of manual CLI runs (apply --out): never committed
/out.cpp

# the manual-run corpus over chromium/brave: fetched data, never committed
/corpus/

# tree-sitter grammars: not committed — scripts/fetch-grammars.ts puts the pinned ones
# here (`npm run grammars`, pretest, prepack) and `npm pack` ships them inside sir
/grammars/

# sir-apply as scripts/build-apply-bin.mjs builds it
/build/

# the archive npm pack produces
*.tgz

# Stryker: its sandbox and its reports, the incremental file among them (kept between runs
# on this machine; CI keeps its own in a cache)
/.stryker-tmp/
/reports/
lcov.info
